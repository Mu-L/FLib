EnumField * {
    border-radius: 0px;
    background-color: initial;
}

Foldout {
    flex-grow: 1;
}

.LabelButton {
    background-color: initial;
    border-radius: 0px;
    border-width: 1px;
    -unity-text-align: middle-left;
    padding: 1px;
    margin: 0px;
}

#Node {
    position: absolute;
}

#Node #BodyContainer {
    flex-direction: row;
    align-items: center;
}

#Node Label {
    font-size: 14px;
    margin: 0px;
    padding: 0px;
    -unity-text-align: middle-center;
}

#Node #Body {
    background-color: #afafaf;
    min-width: 80px;
    padding: 6px 5px 6px 5px;
    border-radius: 2px;
    border-width: 1px;
}

.NodeBodySelected {
    border-color: #00aa00;
}

#Node #Arrow {
    border-top-right-radius: 100%;
    border-bottom-right-radius: 100%;
    height: 60%;
    color: #227722;
    background-color: #afa7af;
}

#Node #Comment {
    font-size: 10px;
    color: #999999;
}

#PropertyPanel {
    position: absolute;
    height: 100%;
    width: 300px;
    right: 0px;
    border-width: 1px;
    border-color: #eeeeee;
    background-color: rgba(221, 221, 219, 0.8);
}

#PropertyPanel Label {
    -unity-text-align: middle-left;
}

#PropertyPanelContent {
    border-width: 1px;
    border-color: #bbbbbb;
    border-radius: 3px;
}